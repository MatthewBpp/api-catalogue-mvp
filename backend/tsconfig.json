{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "rootDir": ".",
    "outDir": "dist",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node", "jest"],

    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
  },

  "files": ["src/types/express.d.ts"],

  "include": ["src", "tests"]
}
